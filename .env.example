# Run python scripts/setup.py to generate .env with unique tokens.
# Tokens must be at least 32 characters. These fields intentionally contain no usable credentials.
# SF_IDENTITIES='[{"name":"lead","role":"admin","token":"GENERATE_A_UNIQUE_SECRET"}]'
# SF_DATABASE_URL=sqlite:///./sentinelforge.db
# SF_RATE_LIMIT=120
# SF_MAX_BODY_BYTES=1048576
# POSTGRES_PASSWORD=GENERATE_A_UNIQUE_SECRET
# SF_LOCAL_MODE=false
# Prefer scripts/run_local.py for explicit token-free loopback-only operation.
